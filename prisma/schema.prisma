generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(cuid())
  name           String?
  email          String      @unique
  hashedPassword String?
  createdAt      DateTime    @default(now())
  trades         Trade[]
  positions      Position[]
  botConfig      BotConfig?
  botLogs        BotLog[]
}

// ─── Trading Models ────────────────────────────────────────────────────────

model Trade {
  id          String      @id @default(cuid())
  userId      String
  symbol      String      // e.g. "BTC/USDT"
  side        TradeSide
  entryPrice  Decimal     @db.Decimal(18, 8)
  exitPrice   Decimal?    @db.Decimal(18, 8)
  quantity    Decimal     @db.Decimal(18, 8)
  pnl         Decimal?    @db.Decimal(18, 8)
  pnlPercent  Decimal?    @db.Decimal(10, 4)
  status      TradeStatus
  strategy    String?
  stopLoss    Decimal?    @db.Decimal(18, 8)
  takeProfit  Decimal?    @db.Decimal(18, 8)
  orderId     String?     // Exchange order ID
  openedAt    DateTime
  closedAt    DateTime?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, openedAt])
}

model Position {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  side        TradeSide
  entryPrice  Decimal   @db.Decimal(18, 8)
  quantity    Decimal   @db.Decimal(18, 8)
  stopLoss    Decimal?  @db.Decimal(18, 8)
  takeProfit  Decimal?  @db.Decimal(18, 8)
  orderId     String?
  strategy    String?
  openedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BotConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  exchange       String   @default("binance")
  symbol         String   @default("BTC/USDT")
  strategy       String   @default("EMA_CROSS")
  isActive       Boolean  @default(false)
  mode           BotMode  @default(PAPER)
  capitalPercent Decimal  @default(2.00) @db.Decimal(5, 2)
  maxDrawdown    Decimal  @default(10.00) @db.Decimal(5, 2)
  maxDailyLoss   Decimal  @default(3.00) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BotLog {
  id        String   @id @default(cuid())
  userId    String
  level     LogLevel
  event     String   // "SIGNAL", "ORDER_PLACED", "BOT_PAUSED", etc.
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, event])
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum BotMode {
  PAPER
  LIVE
}

enum LogLevel {
  INFO
  WARN
  ERROR
  SIGNAL
  ORDER
}
